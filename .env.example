NEXT_PUBLIC_APP_URL=https://app.ridhzo.com

# --- Marketing / analytics tags (all optional) ---
# Each tag only loads when its ID is set AND the visitor accepts cookies.
# Recommended: use GTM as the hub and configure GA4 + Meta Pixel inside GTM
# (set only NEXT_PUBLIC_GTM_ID). To fire tags directly, set the IDs below and
# leave NEXT_PUBLIC_GTM_ID empty to avoid double-counting.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Meta (Facebook/Instagram) Pixel ID, e.g. 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console HTML-tag verification token (the content="..." value)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Blog ---
# Origin of the WordPress install that serves /blog (e.g. https://blog.ridhzo.com). When set, every /blog
# request is proxied there and the Markdown posts in content/blog are dropped from the sitemap.
# Leave empty to serve the Markdown blog.
WORDPRESS_ORIGIN=

# --- Contact form delivery (server-only; configure at least one) ---
# JSON POST of each enquiry (e.g. the Ridhzo app lead webhook, Zapier or Make).
CONTACT_WEBHOOK_URL=
# Email delivery through Resend (https://resend.com). CONTACT_TO_EMAIL accepts a comma-separated list.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a verified Resend sender; defaults to "Ridhzo Website <website@ridhzo.com>".
CONTACT_FROM_EMAIL=

3"}]," (with fallback to TLS 1.2 for legacy clients). We enforce HTTP Strict Transport Security (HSTS) with preloading, preventing protocol downgrade attacks and cookie interception."]}]]}]]}]
22:["$","section",null,{"id":"webhook-security","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold tracking-tight text-foreground flex items-center gap-2.5","children":[["$","$L6",null,{"ref":"$undefined","icon":{"name":"cpu","size":24,"node":[["path",{"d":"M12 20v2","key":"1lh1kg"}],["path",{"d":"M12 2v2","key":"tus03m"}],["path",{"d":"M17 20v2","key":"1rnc9c"}],["path",{"d":"M17 2v2","key":"11trls"}],["path",{"d":"M2 12h2","key":"1t8f8n"}],["path",{"d":"M2 17h2","key":"7oei6x"}],["path",{"d":"M2 7h2","key":"asdhe0"}],["path",{"d":"M20 12h2","key":"1q8mjw"}],["path",{"d":"M20 17h2","key":"1fpfkl"}],["path",{"d":"M20 7h2","key":"1o8tra"}],["path",{"d":"M7 20v2","key":"4gnj0m"}],["path",{"d":"M7 2v2","key":"1i4yhu"}],["rect",{"x":"4","y":"4","width":"16","height":"16","rx":"2","key":"1vbyd7"}],["rect",{"x":"8","y":"8","width":"8","height":"8","rx":"1","key":"z9xiuo"}]]},"className":"h-6 w-6 text-foreground"}],["$","span",null,{"children":"4. Webhook Integrity & HMAC Verification"}]]}],["$","p",null,{"children":"Because leads stream in from external advertising networks, we verify the authenticity of every incoming HTTP POST request before parsing:"}],["$","ul",null,{"className":"list-disc pl-5 space-y-2 text-xs sm:text-sm","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Meta Facebook Lead Ads:"}]," We inspect the ",["$","code",null,{"children":"X-Hub-Signature-256"}]," header on every inbound webhook, verifying the SHA-256 HMAC payload against your App Secret. Payloads with invalid or missing signatures are rejected with an HTTP 403 response before database ingestion."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Google Lead Form Webhooks:"}]," Inbound requests are matched against your configured secret key in constant time (preventing timing attacks)."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Idempotency & Replay Protection:"}]," Webhook events are tagged with unique event IDs and cached for 48 hours to prevent duplicate lead creation caused by network retry loops."]}]]}]]}]
23:["$","section",null,{"id":"pwa-offline","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold tracking-tight text-foreground flex items-center gap-2.5","children":[["$","$L6",null,{"ref":"$undefined","icon":"$1f:props:icon","className":"h-6 w-6 text-foreground"}],["$","span",null,{"children":"5. Mobile PWA Offline Security"}]]}],["$","p",null,{"children":"Ridhzo is designed for reps in the field with patchy network connectivity. Our offline sync outbox implements rigorous device-level safeguards:"}],["$","ul",null,{"className":"list-disc pl-5 space-y-1.5 text-xs sm:text-sm","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Origin-Bound IndexedDB:"}]," Offline lead updates are stored exclusively within the browser's origin-isolated IndexedDB storage sandbox, inaccessible to other web applications or browser tabs."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Session Expiry Invalidation:"}]," If an agent's JWT authentication session is revoked or expired on the server, the offline cache is wiped immediately upon the next network heartbeat."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Conflict Resolution Locks:"}]," Offline edits sync using optimistic concurrency control to prevent data overwrite collisions when multiple reps update lead records simultaneously."]}]]}]]}]

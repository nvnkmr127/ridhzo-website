":"Sales Agent"}],["$","td",null,{"className":"p-3","children":"Assigned leads only, 1-tap WhatsApp messaging, personal follow-up radar"}],["$","td",null,{"className":"p-3","children":"None (Cannot export full database or view other reps' leads)"}]]}]]}]]}]}]]}]
